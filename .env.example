# ==========================================
# LocalConnect Environment Configuration
# ==========================================

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/localconnect

# JSON Web Token Secret for Session Cookies
JWT_SECRET=super_secret_localconnect_jwt_token_key_fyp_2026

# Cloudinary Storage Configuration (Optional - Local mock fallback is active if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistent Socket.IO Real-Time Server URL
SOCKET_SERVER_URL=http://localhost:4001
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:4001

# Default Platform Admin Credentials for Seeding
ADMIN_EMAIL=admin@localconnect.pk
ADMIN_PASSWORD=Admin@12345

